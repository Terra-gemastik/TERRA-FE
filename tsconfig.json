{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // No `baseUrl`: deprecated in TypeScript 6. Paths resolve relative to
    // this file, which is what we want anyway.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
