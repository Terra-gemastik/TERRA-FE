# Copy to .env. Expo exposes EXPO_PUBLIC_* variables to the client bundle.

# Where the TERRA backend lives.
#
# IMPORTANT on a physical device: "localhost" means the phone itself, not your
# laptop. Use your machine's LAN IP (ipconfig / ifconfig) so the device can
# reach the backend.
#
#   Android emulator      http://10.0.2.2:8000
#   iOS simulator         http://127.0.0.1:8000
#   Physical device       http://192.168.x.x:8000
#   Deployed              https://your-project.vercel.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
